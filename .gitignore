# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js — local dev build + static export output (regenerated by `npm run build`)
/.next/
/out/

# production
/build

# testing
/coverage

# lint cache
.eslintcache

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
*.pem

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# local agent setup — skills, sessions, machine-specific config
.opencode/
AGENTS.md
PRODUCT.md

# planning inputs — spec, brief, source photos, brochure/deck PDFs.
# Site images load from public/images/ (committed copies), so ignoring
# this does NOT break the website. Re-add locally from the team drive
# if you need the source assets.
/context/

# NOTE: intentionally TRACKED in this repo —
# package-lock.json (reproducible installs), public/images/* (the real Heaven
# product photos the site actually serves), tsconfig.json,
# eslint.config.mjs, postcss.config.mjs
# NOTE: intentionally IGNORED — .opencode/ (local agent skills/sessions),
# AGENTS.md (local agent instructions), PRODUCT.md (local product context),
# and context/ (planning inputs + source PDFs) stay on your machine only.
